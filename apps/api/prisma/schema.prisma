// FinAgent AI v1 — esquema relacional.
// Reglas: UUID, dinero en Decimal(18,2), fechas contables en @db.Date, snake_case en BD.
// Las tablas de cada módulo se agregan en la fase que las usa (ver docs/PHASE-0-AUDIT.md §4).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuditSource {
  UI
  API
  WORKER
  SYSTEM
}

enum ReconciliationStatus {
  PREPARATION
  SUBMITTED
  REVIEWED
  APPROVED
  CLOSED
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  EXPORTED
  REVERSED
}

model Organization {
  id                 String             @id @default(uuid(7)) @db.Uuid
  nit                String             @unique
  legalName          String             @map("legal_name")
  functionalCurrency String             @default("COP") @map("functional_currency") @db.Char(3)
  status             OrganizationStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?            @map("created_by") @db.Uuid

  auditLogs              AuditLog[]
  members                OrganizationMember[]
  roles                  Role[]
  invitations            Invitation[]
  banks                  Bank[]
  bankAccounts           BankAccount[]
  glAccounts             GlAccount[]
  feeMappings            FeeTypeAccountMapping[]
  periods                AccountingPeriod[]
  holidays               Holiday[]
  importTemplates        ImportTemplate[]
  documents              Document[]
  bankTransactions       BankTransaction[]
  accountingTransactions AccountingTransaction[]
  matchingRuleVersions   MatchingRuleVersion[]
  matchingRuns           MatchingRun[]
  confirmedMatches       ConfirmedMatch[]
  reconciliations        Reconciliation[]
  adjustmentEntries      AdjustmentEntry[]

  @@map("organizations")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique
  fullName          String     @map("full_name")
  passwordHash      String?    @map("password_hash")
  status            UserStatus @default(INVITED)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz
  /// Bloqueo temporal tras intentos fallidos de inicio de sesión.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz

  memberships    OrganizationMember[]
  sessions       UserSession[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

/// Bitácora inmutable: solo inserción (trigger en la migración bloquea UPDATE/DELETE).
model AuditLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?     @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  source         AuditSource
  ip             String?
  correlationId  String?     @map("correlation_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

/// Rol de sistema (organization_id nulo, no editable) o personalizado por organización.
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization?        @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

/// Catálogo de permisos (definido en código, sincronizado por migración).
model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         MemberStatus @default(ACTIVE)
  /// ALL = todas las cuentas bancarias de la organización; SELECTED = solo las de member_bank_accounts.
  accountScope   AccountScope @default(ALL) @map("account_scope")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?      @map("created_by") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  role         Role                @relation(fields: [roleId], references: [id])
  bankAccounts MemberBankAccount[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Refresh tokens rotativos. Se guarda solo el hash SHA-256; `familyId` agrupa una cadena de rotación.
model UserSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

enum AccountScope {
  ALL
  SELECTED
}

enum BankAccountType {
  CORRIENTE
  AHORROS
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum GlNature {
  DEBITO
  CREDITO
}

/// Catálogo de bancos: precargados (organization_id nulo) o agregados por una organización.
model Bank {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id])
  accounts     BankAccount[]
  templates    ImportTemplate[]

  @@unique([organizationId, name])
  @@map("banks")
}

model BankAccount {
  id                 String          @id @default(uuid(7)) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  bankId             String          @map("bank_id") @db.Uuid
  name               String
  /// Número cifrado (AES-256-GCM, "v1:iv:tag:cifrado"). Nunca se guarda en claro.
  accountNumberEnc   String          @map("account_number_enc")
  /// HMAC del número: permite la restricción de unicidad sin conocer el número.
  accountNumberHmac  String          @map("account_number_hmac")
  accountLast4       String          @map("account_last4") @db.VarChar(4)
  type               BankAccountType
  currency           String          @db.Char(3)
  glAccountId        String          @map("gl_account_id") @db.Uuid
  openingBalance     Decimal         @map("opening_balance") @db.Decimal(18, 2)
  openingBalanceDate DateTime        @map("opening_balance_date") @db.Date
  openedAt           DateTime?       @map("opened_at") @db.Date
  status             ActiveStatus    @default(ACTIVE)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?         @map("created_by") @db.Uuid

  organization     Organization            @relation(fields: [organizationId], references: [id])
  bank             Bank                    @relation(fields: [bankId], references: [id])
  glAccount        GlAccount               @relation(fields: [glAccountId], references: [id])
  members          MemberBankAccount[]
  documents        Document[]
  bankTxs          BankTransaction[]
  bookTxs          AccountingTransaction[]
  matchingRuns     MatchingRun[]
  confirmedMatches ConfirmedMatch[]
  reconciliations  Reconciliation[]

  @@unique([organizationId, bankId, accountNumberHmac])
  @@index([organizationId])
  @@map("bank_accounts")
}

model MemberBankAccount {
  memberId      String @map("member_id") @db.Uuid
  bankAccountId String @map("bank_account_id") @db.Uuid

  member      OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bankAccount BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@id([memberId, bankAccountId])
  @@map("member_bank_accounts")
}

/// Plan de cuentas (PUC) por organización.
model GlAccount {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String       @db.VarChar(12)
  name            String
  nature          GlNature
  level           Int          @db.SmallInt
  acceptsMovement Boolean      @map("accepts_movement")
  status          ActiveStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?      @map("created_by") @db.Uuid

  organization    Organization            @relation(fields: [organizationId], references: [id])
  bankAccounts    BankAccount[]
  feeMappings     FeeTypeAccountMapping[]
  adjustmentLines AdjustmentLine[]

  @@unique([organizationId, code])
  @@map("chart_of_accounts")
}

/// Tipo de nota bancaria → cuenta contable del asiento de ajuste.
model FeeTypeAccountMapping {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  feeType        String   @map("fee_type")
  glAccountId    String   @map("gl_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id])

  @@unique([organizationId, feeType])
  @@map("fee_type_account_mappings")
}

/// Mes contable de la organización. El estado por cuenta vive en la conciliación (cuenta + periodo).
model AccountingPeriod {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  year           Int      @db.SmallInt
  month          Int      @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization     Organization            @relation(fields: [organizationId], references: [id])
  documents        Document[]
  bankTxs          BankTransaction[]
  bookTxs          AccountingTransaction[]
  matchingRuns     MatchingRun[]
  confirmedMatches ConfirmedMatch[]
  reconciliations  Reconciliation[]

  @@unique([organizationId, year, month])
  @@map("accounting_periods")
}

/// Festivos adicionales de la organización. Los nacionales se calculan (Ley 51 de 1983) y no se guardan.
model Holiday {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  date           DateTime @db.Date
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@map("holidays")
}

/// BANK = extracto bancario · BOOK = auxiliar contable de la cuenta banco.
enum LedgerSide {
  BANK
  BOOK
}

enum DocumentStatus {
  UPLOADED
  IMPORTING
  IMPORTED
  FAILED
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum RowStatus {
  OK
  ERROR
  SKIPPED
}

enum DuplicateStatus {
  NONE
  POSSIBLE
  CONFIRMED
  DISMISSED
}

enum MatchingRunStatus {
  COMPLETED
  FAILED
}

enum MatchingRuleKind {
  EXACT
  BUSINESS_DATE
  GROUP_SUM
  APPROXIMATE
  FEE_CLASSIFICATION
}

enum MatchingResultStatus {
  EXACT
  PROBABLE
  AMBIGUOUS
  AMOUNT_DIFFERENCE
  DATE_DIFFERENCE
  BANK_UNMATCHED
  BOOK_UNMATCHED
  POSSIBLE_DUPLICATE
  BANK_FEE
  CARRIED_FORWARD
}

enum ConfirmedMatchStatus {
  CONFIRMED
  REVERSED
}

enum SuggestionReviewStatus {
  OPEN
  CONFIRMED
  REJECTED
  REQUIRES_REVIEW
  REVERSED
}

/// Plantilla de lectura por banco (extracto) o por software contable (auxiliar). La configuración vive en versiones.
model ImportTemplate {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  side            LedgerSide
  bankId          String?      @map("bank_id") @db.Uuid
  software        String?
  format          String
  currentVersion  Int          @default(1) @map("current_version")
  /// Firma del encabezado de la versión vigente: permite sugerir la plantilla al subir un archivo.
  headerSignature String?      @map("header_signature")
  status          ActiveStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?      @map("created_by") @db.Uuid

  organization Organization            @relation(fields: [organizationId], references: [id])
  bank         Bank?                   @relation(fields: [bankId], references: [id])
  versions     ImportTemplateVersion[]

  @@unique([organizationId, name])
  @@index([organizationId, side, headerSignature])
  @@map("import_templates")
}

model ImportTemplateVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  version         Int
  config          Json
  headerSignature String?  @map("header_signature")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.Uuid

  template ImportTemplate   @relation(fields: [templateId], references: [id])
  imports  DocumentImport[]

  @@unique([templateId, version])
  @@map("import_template_versions")
}

/// Archivo original, inmutable durante la retención. Mismo archivo (SHA-256) para la misma cuenta y lado → rechazado.
model Document {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  bankAccountId  String         @map("bank_account_id") @db.Uuid
  periodId       String         @map("period_id") @db.Uuid
  side           LedgerSide
  fileName       String         @map("file_name")
  format         String
  sizeBytes      Int            @map("size_bytes")
  sha256         String         @db.Char(64)
  storageKey     String         @unique @map("storage_key")
  status         DocumentStatus @default(UPLOADED)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  uploadedBy     String         @map("uploaded_by") @db.Uuid

  organization Organization            @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount             @relation(fields: [bankAccountId], references: [id])
  period       AccountingPeriod        @relation(fields: [periodId], references: [id])
  imports      DocumentImport[]
  bankTxs      BankTransaction[]
  bookTxs      AccountingTransaction[]

  @@unique([organizationId, bankAccountId, side, sha256])
  @@index([organizationId, bankAccountId, periodId])
  @@map("documents")
}

model DocumentImport {
  id                String       @id @default(uuid(7)) @db.Uuid
  documentId        String       @map("document_id") @db.Uuid
  templateVersionId String?      @map("template_version_id") @db.Uuid
  idempotencyKey    String       @unique @map("idempotency_key")
  status            ImportStatus @default(QUEUED)
  progress          Int          @default(0) @db.SmallInt
  rowCount          Int          @default(0) @map("row_count")
  importedCount     Int          @default(0) @map("imported_count")
  skippedCount      Int          @default(0) @map("skipped_count")
  errorCount        Int          @default(0) @map("error_count")
  duplicateCount    Int          @default(0) @map("duplicate_count")
  openingBalance    Decimal?     @map("opening_balance") @db.Decimal(18, 2)
  closingBalance    Decimal?     @map("closing_balance") @db.Decimal(18, 2)
  inflows           Decimal?     @db.Decimal(18, 2)
  outflows          Decimal?     @db.Decimal(18, 2)
  balanced          Boolean?
  balanceDifference Decimal?     @map("balance_difference") @db.Decimal(18, 2)
  /// Obligatoria si los saldos no cuadran (queda en auditoría).
  justification     String?
  warnings          Json         @default("[]")
  failureReason     String?      @map("failure_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  startedAt         DateTime?    @map("started_at") @db.Timestamptz
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz
  createdBy         String       @map("created_by") @db.Uuid

  document        Document               @relation(fields: [documentId], references: [id])
  templateVersion ImportTemplateVersion? @relation(fields: [templateVersionId], references: [id])
  rows            DocumentRow[]

  @@index([documentId])
  @@map("document_imports")
}

/// Fila de origen tal cual vino (raw) y su versión normalizada: trazabilidad completa.
model DocumentRow {
  id         String    @id @default(uuid(7)) @db.Uuid
  importId   String    @map("import_id") @db.Uuid
  rowNumber  Int       @map("row_number")
  raw        Json
  normalized Json?
  status     RowStatus
  errors     Json      @default("[]")

  import DocumentImport         @relation(fields: [importId], references: [id])
  bankTx BankTransaction?
  bookTx AccountingTransaction?

  @@unique([importId, rowNumber])
  @@map("document_rows")
}

/// Movimiento del extracto. Importe con signo: + entra, − sale. Nunca se elimina ni se sobrescribe el original.
model BankTransaction {
  id                    String          @id @default(uuid(7)) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  bankAccountId         String          @map("bank_account_id") @db.Uuid
  periodId              String          @map("period_id") @db.Uuid
  documentId            String          @map("document_id") @db.Uuid
  documentRowId         String          @unique @map("document_row_id") @db.Uuid
  externalId            String?         @map("external_id")
  operationDate         DateTime        @map("operation_date") @db.Date
  valueDate             DateTime?       @map("value_date") @db.Date
  descriptionOriginal   String          @map("description_original")
  descriptionNormalized String          @map("description_normalized")
  reference             String?
  documentNumber        String?         @map("document_number")
  amount                Decimal         @db.Decimal(18, 2)
  currency              String          @db.Char(3)
  runningBalance        Decimal?        @map("running_balance") @db.Decimal(18, 2)
  contentFingerprint    String          @map("content_fingerprint") @db.Char(64)
  sourceFingerprint     String          @unique @map("source_fingerprint") @db.Char(64)
  duplicateStatus       DuplicateStatus @default(NONE) @map("duplicate_status")
  duplicateOfId         String?         @map("duplicate_of_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization        Organization         @relation(fields: [organizationId], references: [id])
  bankAccount         BankAccount          @relation(fields: [bankAccountId], references: [id])
  period              AccountingPeriod     @relation(fields: [periodId], references: [id])
  document            Document             @relation(fields: [documentId], references: [id])
  documentRow         DocumentRow          @relation(fields: [documentRowId], references: [id])
  confirmedMatchItems ConfirmedMatchItem[]

  @@index([bankAccountId, operationDate])
  @@index([bankAccountId, amount])
  @@index([bankAccountId, contentFingerprint])
  @@index([organizationId, periodId])
  @@map("bank_transactions")
}

/// Movimiento del auxiliar contable (cuenta banco). Importe con signo: + débito (entra), − crédito (sale).
model AccountingTransaction {
  id                    String          @id @default(uuid(7)) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  bankAccountId         String          @map("bank_account_id") @db.Uuid
  periodId              String          @map("period_id") @db.Uuid
  documentId            String          @map("document_id") @db.Uuid
  documentRowId         String          @unique @map("document_row_id") @db.Uuid
  externalId            String?         @map("external_id")
  operationDate         DateTime        @map("operation_date") @db.Date
  valueDate             DateTime?       @map("value_date") @db.Date
  descriptionOriginal   String          @map("description_original")
  descriptionNormalized String          @map("description_normalized")
  reference             String?
  documentNumber        String?         @map("document_number")
  thirdParty            String?         @map("third_party")
  thirdPartyNit         String?         @map("third_party_nit")
  amount                Decimal         @db.Decimal(18, 2)
  currency              String          @db.Char(3)
  runningBalance        Decimal?        @map("running_balance") @db.Decimal(18, 2)
  contentFingerprint    String          @map("content_fingerprint") @db.Char(64)
  sourceFingerprint     String          @unique @map("source_fingerprint") @db.Char(64)
  duplicateStatus       DuplicateStatus @default(NONE) @map("duplicate_status")
  duplicateOfId         String?         @map("duplicate_of_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization        Organization         @relation(fields: [organizationId], references: [id])
  bankAccount         BankAccount          @relation(fields: [bankAccountId], references: [id])
  period              AccountingPeriod     @relation(fields: [periodId], references: [id])
  document            Document             @relation(fields: [documentId], references: [id])
  documentRow         DocumentRow          @relation(fields: [documentRowId], references: [id])
  confirmedMatchItems ConfirmedMatchItem[]

  @@index([bankAccountId, operationDate])
  @@index([bankAccountId, amount])
  @@index([bankAccountId, contentFingerprint])
  @@index([organizationId, periodId])
  @@map("accounting_transactions")
}

/// Snapshot versionado de las reglas deterministas de una organización.
model MatchingRuleVersion {
  id                         String   @id @default(uuid(7)) @db.Uuid
  organizationId             String   @map("organization_id") @db.Uuid
  version                    Int
  dateToleranceBusinessDays  Int      @default(3) @map("date_tolerance_business_days") @db.SmallInt
  amountTolerance            Decimal  @default(1000) @map("amount_tolerance") @db.Decimal(18, 2)
  amountToleranceBasisPoints Int      @default(10) @map("amount_tolerance_basis_points") @db.SmallInt
  maxGroupSize               Int      @default(6) @map("max_group_size") @db.SmallInt
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy                  String?  @map("created_by") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id])
  runs         MatchingRun[]

  @@unique([organizationId, version])
  @@map("matching_rule_versions")
}

/// Ejecución reproducible sobre una cuenta y periodo, vinculada a la versión exacta de reglas.
model MatchingRun {
  id                   String            @id @default(uuid(7)) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  bankAccountId        String            @map("bank_account_id") @db.Uuid
  periodId             String            @map("period_id") @db.Uuid
  ruleVersionId        String            @map("rule_version_id") @db.Uuid
  status               MatchingRunStatus @default(COMPLETED)
  inputFingerprint     String            @map("input_fingerprint") @db.Char(64)
  idempotencyKey       String            @map("idempotency_key")
  bankTransactionCount Int               @default(0) @map("bank_transaction_count")
  bookTransactionCount Int               @default(0) @map("book_transaction_count")
  suggestionCount      Int               @default(0) @map("suggestion_count")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String            @map("created_by") @db.Uuid

  organization Organization         @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount          @relation(fields: [bankAccountId], references: [id])
  period       AccountingPeriod     @relation(fields: [periodId], references: [id])
  ruleVersion  MatchingRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  suggestions  MatchingSuggestion[]
  matches      ConfirmedMatch[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, bankAccountId, periodId, createdAt])
  @@map("matching_runs")
}

/// Resultado inmutable de una ejecución. Los IDs guardados permiten reproducir y explicar cada propuesta.
model MatchingSuggestion {
  id                       String                 @id @default(uuid(7)) @db.Uuid
  runId                    String                 @map("run_id") @db.Uuid
  rule                     MatchingRuleKind
  status                   MatchingResultStatus
  reviewStatus             SuggestionReviewStatus @default(OPEN) @map("review_status")
  score                    Int                    @default(0) @db.SmallInt
  bankTransactionIds       Json                   @default("[]") @map("bank_transaction_ids")
  accountingTransactionIds Json                   @default("[]") @map("accounting_transaction_ids")
  amountDifference         Decimal                @default(0) @map("amount_difference") @db.Decimal(18, 2)
  dateDifferenceDays       Int                    @default(0) @map("date_difference_days")
  explanation              String
  feeType                  String?                @map("fee_type")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz

  run     MatchingRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  matches ConfirmedMatch[]

  @@index([runId, status])
  @@map("matching_suggestions")
}

/// Aceptación humana de una sugerencia. La unicidad por movimiento se aplica con índices parciales en SQL.
model ConfirmedMatch {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  bankAccountId  String               @map("bank_account_id") @db.Uuid
  periodId       String               @map("period_id") @db.Uuid
  runId          String               @map("run_id") @db.Uuid
  suggestionId   String               @map("suggestion_id") @db.Uuid
  status         ConfirmedMatchStatus @default(CONFIRMED)
  confirmedBy    String               @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime             @default(now()) @map("confirmed_at") @db.Timestamptz
  reversedBy     String?              @map("reversed_by") @db.Uuid
  reversedAt     DateTime?            @map("reversed_at") @db.Timestamptz
  reversalReason String?              @map("reversal_reason")

  organization Organization         @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount          @relation(fields: [bankAccountId], references: [id])
  period       AccountingPeriod     @relation(fields: [periodId], references: [id])
  run          MatchingRun          @relation(fields: [runId], references: [id])
  suggestion   MatchingSuggestion   @relation(fields: [suggestionId], references: [id])
  items        ConfirmedMatchItem[]

  @@map("confirmed_matches")
}

model ConfirmedMatchItem {
  id                      String     @id @default(uuid(7)) @db.Uuid
  confirmedMatchId        String     @map("confirmed_match_id") @db.Uuid
  side                    LedgerSide
  bankTransactionId       String?    @map("bank_transaction_id") @db.Uuid
  accountingTransactionId String?    @map("accounting_transaction_id") @db.Uuid
  isActive                Boolean    @default(true) @map("is_active")

  confirmedMatch        ConfirmedMatch         @relation(fields: [confirmedMatchId], references: [id], onDelete: Cascade)
  bankTransaction       BankTransaction?       @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  accountingTransaction AccountingTransaction? @relation(fields: [accountingTransactionId], references: [id], onDelete: Restrict)

  @@index([confirmedMatchId])
  @@map("confirmed_match_items")
}

/// Estado de revisión por cuenta y periodo. Cierre y snapshot quedan versionados.
model Reconciliation {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  bankAccountId  String               @map("bank_account_id") @db.Uuid
  periodId       String               @map("period_id") @db.Uuid
  status         ReconciliationStatus @default(PREPARATION)
  version        Int                  @default(1)
  preparedBy     String               @map("prepared_by") @db.Uuid
  submittedAt    DateTime?            @map("submitted_at") @db.Timestamptz
  reviewedBy     String?              @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?            @map("reviewed_at") @db.Timestamptz
  approvedBy     String?              @map("approved_by") @db.Uuid
  approvedAt     DateTime?            @map("approved_at") @db.Timestamptz
  closedAt       DateTime?            @map("closed_at") @db.Timestamptz
  snapshot       Json?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id])
  period       AccountingPeriod  @relation(fields: [periodId], references: [id])
  adjustments  AdjustmentEntry[]

  @@unique([bankAccountId, periodId])
  @@index([organizationId, status])
  @@map("reconciliations")
}

/// Asiento de ajuste, inmutable tras aprobación salvo reversión explícita.
model AdjustmentEntry {
  id                       String           @id @default(uuid(7)) @db.Uuid
  organizationId           String           @map("organization_id") @db.Uuid
  reconciliationId         String           @map("reconciliation_id") @db.Uuid
  status                   AdjustmentStatus @default(DRAFT)
  entryDate                DateTime         @map("entry_date") @db.Date
  description              String
  currency                 String           @db.Char(3)
  reversalOfId             String?          @map("reversal_of_id") @db.Uuid
  sourceReconcilingItemIds Json             @default("[]") @map("source_reconciling_item_ids")
  createdBy                String           @map("created_by") @db.Uuid
  approvedBy               String?          @map("approved_by") @db.Uuid
  approvedAt               DateTime?        @map("approved_at") @db.Timestamptz
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization      @relation(fields: [organizationId], references: [id])
  reconciliation Reconciliation    @relation(fields: [reconciliationId], references: [id])
  reversalOf     AdjustmentEntry?  @relation("AdjustmentReversal", fields: [reversalOfId], references: [id])
  reversals      AdjustmentEntry[] @relation("AdjustmentReversal")
  lines          AdjustmentLine[]

  @@index([organizationId, reconciliationId, status])
  @@map("adjustment_entries")
}

model AdjustmentLine {
  id                String  @id @default(uuid(7)) @db.Uuid
  adjustmentEntryId String  @map("adjustment_entry_id") @db.Uuid
  glAccountId       String  @map("gl_account_id") @db.Uuid
  debit             Decimal @default(0) @db.Decimal(18, 2)
  credit            Decimal @default(0) @db.Decimal(18, 2)
  costCenter        String? @map("cost_center")

  entry     AdjustmentEntry @relation(fields: [adjustmentEntryId], references: [id], onDelete: Cascade)
  glAccount GlAccount       @relation(fields: [glAccountId], references: [id])

  @@index([adjustmentEntryId])
  @@map("adjustment_entry_lines")
}
