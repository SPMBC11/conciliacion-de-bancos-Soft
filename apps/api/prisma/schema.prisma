// FinAgent AI v1 — esquema relacional.
// Reglas: UUID, dinero en Decimal(18,2), fechas contables en @db.Date, snake_case en BD.
// Las tablas de cada módulo se agregan en la fase que las usa (ver docs/PHASE-0-AUDIT.md §4).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuditSource {
  UI
  API
  WORKER
  SYSTEM
}

model Organization {
  id                 String             @id @default(uuid(7)) @db.Uuid
  nit                String             @unique
  legalName          String             @map("legal_name")
  functionalCurrency String             @default("COP") @map("functional_currency") @db.Char(3)
  status             OrganizationStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?            @map("created_by") @db.Uuid

  auditLogs    AuditLog[]
  members      OrganizationMember[]
  roles        Role[]
  invitations  Invitation[]
  banks        Bank[]
  bankAccounts BankAccount[]
  glAccounts   GlAccount[]
  feeMappings  FeeTypeAccountMapping[]
  periods      AccountingPeriod[]
  holidays     Holiday[]

  @@map("organizations")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique
  fullName          String     @map("full_name")
  passwordHash      String?    @map("password_hash")
  status            UserStatus @default(INVITED)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz
  /// Bloqueo temporal tras intentos fallidos de inicio de sesión.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz

  memberships    OrganizationMember[]
  sessions       UserSession[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

/// Bitácora inmutable: solo inserción (trigger en la migración bloquea UPDATE/DELETE).
model AuditLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?     @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  source         AuditSource
  ip             String?
  correlationId  String?     @map("correlation_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

/// Rol de sistema (organization_id nulo, no editable) o personalizado por organización.
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization?        @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

/// Catálogo de permisos (definido en código, sincronizado por migración).
model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         MemberStatus @default(ACTIVE)
  /// ALL = todas las cuentas bancarias de la organización; SELECTED = solo las de member_bank_accounts.
  accountScope   AccountScope @default(ALL) @map("account_scope")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?      @map("created_by") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  role         Role                @relation(fields: [roleId], references: [id])
  bankAccounts MemberBankAccount[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Refresh tokens rotativos. Se guarda solo el hash SHA-256; `familyId` agrupa una cadena de rotación.
model UserSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

enum AccountScope {
  ALL
  SELECTED
}

enum BankAccountType {
  CORRIENTE
  AHORROS
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum GlNature {
  DEBITO
  CREDITO
}

/// Catálogo de bancos: precargados (organization_id nulo) o agregados por una organización.
model Bank {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])
  accounts     BankAccount[]

  @@unique([organizationId, name])
  @@map("banks")
}

model BankAccount {
  id                 String          @id @default(uuid(7)) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  bankId             String          @map("bank_id") @db.Uuid
  name               String
  /// Número cifrado (AES-256-GCM, "v1:iv:tag:cifrado"). Nunca se guarda en claro.
  accountNumberEnc   String          @map("account_number_enc")
  /// HMAC del número: permite la restricción de unicidad sin conocer el número.
  accountNumberHmac  String          @map("account_number_hmac")
  accountLast4       String          @map("account_last4") @db.VarChar(4)
  type               BankAccountType
  currency           String          @db.Char(3)
  glAccountId        String          @map("gl_account_id") @db.Uuid
  openingBalance     Decimal         @map("opening_balance") @db.Decimal(18, 2)
  openingBalanceDate DateTime        @map("opening_balance_date") @db.Date
  openedAt           DateTime?       @map("opened_at") @db.Date
  status             ActiveStatus    @default(ACTIVE)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?         @map("created_by") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id])
  bank         Bank                @relation(fields: [bankId], references: [id])
  glAccount    GlAccount           @relation(fields: [glAccountId], references: [id])
  members      MemberBankAccount[]

  @@unique([organizationId, bankId, accountNumberHmac])
  @@index([organizationId])
  @@map("bank_accounts")
}

model MemberBankAccount {
  memberId      String @map("member_id") @db.Uuid
  bankAccountId String @map("bank_account_id") @db.Uuid

  member      OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bankAccount BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@id([memberId, bankAccountId])
  @@map("member_bank_accounts")
}

/// Plan de cuentas (PUC) por organización.
model GlAccount {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String       @db.VarChar(12)
  name            String
  nature          GlNature
  level           Int          @db.SmallInt
  acceptsMovement Boolean      @map("accepts_movement")
  status          ActiveStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?      @map("created_by") @db.Uuid

  organization Organization            @relation(fields: [organizationId], references: [id])
  bankAccounts BankAccount[]
  feeMappings  FeeTypeAccountMapping[]

  @@unique([organizationId, code])
  @@map("chart_of_accounts")
}

/// Tipo de nota bancaria → cuenta contable del asiento de ajuste.
model FeeTypeAccountMapping {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  feeType        String   @map("fee_type")
  glAccountId    String   @map("gl_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id])

  @@unique([organizationId, feeType])
  @@map("fee_type_account_mappings")
}

/// Mes contable de la organización. El estado por cuenta vive en la conciliación (cuenta + periodo).
model AccountingPeriod {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  year           Int      @db.SmallInt
  month          Int      @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year, month])
  @@map("accounting_periods")
}

/// Festivos adicionales de la organización. Los nacionales se calculan (Ley 51 de 1983) y no se guardan.
model Holiday {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  date           DateTime @db.Date
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@map("holidays")
}
