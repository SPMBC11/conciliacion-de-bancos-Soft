{
  "name": "@finagent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "dev:worker": "nest start --watch -c nest-cli.worker-dev.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "bootstrap": "node dist/cli/bootstrap-owner.js",
    "test:perf": "PERF=1 vitest run test/perf.import.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@finagent/contracts": "^0.1.0",
    "@finagent/domain": "^0.1.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "@finagent/parsers": "0.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
