{
  "name": "finagent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis storage mailpit",
    "infra:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run build -w @finagent/domain -w @finagent/contracts && concurrently -k -n api,worker,web -c blue,magenta,green \"npm run dev -w @finagent/api\" \"npm run dev:worker -w @finagent/api\" \"npm run dev -w @finagent/web\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @finagent/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@swc/core@1.16.22": true,
    "fsevents@2.3.3": true,
    "@scarf/scarf": false,
    "msgpackr-extract": false
  }
}
