# Copiar a .env para desarrollo local. NUNCA poner aquí secretos de producción ni datos reales.
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL 16 (docker compose)
DATABASE_URL=postgresql://finagent:finagent_dev@localhost:5432/finagent

# Redis (colas BullMQ)
REDIS_URL=redis://localhost:6379

# Almacenamiento privado compatible con S3 (SeaweedFS en desarrollo)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=finagent-documents
S3_ACCESS_KEY=finagent
S3_SECRET_KEY=finagent_dev_secret

# Correo (Mailpit en desarrollo: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="FinAgent AI <no-reply@finagent.local>"

# Autenticación. JWT_SECRET: mínimo 32 caracteres aleatorios (openssl rand -base64 48). En producción COOKIE_SECURE=true (HTTPS).
JWT_SECRET=dev_only_change_me_dev_only_change_me_0123456789
COOKIE_SECURE=false
# Límite de intentos por minuto y por IP en login, recuperación e invitaciones.
AUTH_RATE_LIMIT=10
